{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "FireCal Design Tokens",
  "version": "1.0.0",
  "description": "Base design tokens for FireCal NASA Space Apps Challenge - Cyber Techno & Deep Space theme",
  "color": {
    "brand": {
      "solar-flare": {
        "ember": {
          "$value": "#E04006",
          "$type": "color",
          "$description": "Extreme Fire & Thermal peak accent (rgb: 224, 64, 6)"
        },
        "orange": {
          "$value": "#FF6B1A",
          "$type": "color",
          "$description": "Primary CTA, Active Fire status (rgb: 255, 107, 26)"
        },
        "amber": {
          "$value": "#FF9F1C",
          "$type": "color",
          "$description": "Interactive hover, Warning thermal flare (rgb: 255, 159, 28)"
        },
        "yellow": {
          "$value": "#FFD23F",
          "$type": "color",
          "$description": "Peak hotspot highlight, Solar glow (rgb: 255, 210, 63)"
        }
      },
      "flora": {
        "light": {
          "$value": "#5FD678",
          "$type": "color",
          "$description": "Logo leaf gradient start / Healthy vegetative canopy (rgb: 95, 214, 120)"
        },
        "emerald": {
          "$value": "#2CBC84",
          "$type": "color",
          "$description": "Logo leaf gradient end / Deep rainforest foliage (rgb: 44, 188, 132)"
        }
      },
      "earth": {
        "blue": {
          "$value": "#0180E7",
          "$type": "color",
          "$description": "NASA Earth observation / Satellite telemetry blue (rgb: 1, 128, 231)"
        }
      }
    },
    "space": {
      "void": {
        "$value": "#05050C",
        "$type": "color",
        "$description": "Surface Void / Deepest orbital dark backdrop (rgb: 5, 5, 12)"
      },
      "base": {
        "$value": "#090A15",
        "$type": "color",
        "$description": "Surface Base / Main application background (rgb: 9, 10, 21)"
      },
      "panel": {
        "$value": "#0E1022",
        "$type": "color",
        "$description": "Surface Panel / Card & sidebar container (rgb: 14, 16, 34)"
      },
      "elevated": {
        "$value": "#151833",
        "$type": "color",
        "$description": "Surface Elevated / Dropdowns, popovers (rgb: 21, 24, 51)"
      },
      "overlay": {
        "$value": "#1C2044",
        "$type": "color",
        "$description": "Surface Overlay / Modal sheets, floating tooltips (rgb: 28, 32, 68)"
      },
      "navy-dark": {
        "$value": "#031044",
        "$type": "color",
        "$description": "Deep Cosmic Navy from base swatches (rgb: 3, 16, 68)"
      },
      "sapphire": {
        "$value": "#051D87",
        "$type": "color",
        "$description": "Deep Sapphire Blue accent from base swatches (rgb: 5, 29, 135)"
      },
      "atmosphere": {
        "$value": "#71B3F7",
        "$type": "color",
        "$description": "Atmosphere sky accent blue (rgb: 113, 179, 247)"
      }
    },
    "border": {
      "subtle": {
        "$value": "#232752",
        "$type": "color",
        "$description": "Low-contrast border for panels and dividers (rgb: 35, 39, 82)"
      },
      "techno": {
        "$value": "#3A4186",
        "$type": "color",
        "$description": "Medium-contrast border with cyber techno identity (rgb: 58, 65, 134)"
      },
      "glow": {
        "$value": "#5B66D6",
        "$type": "color",
        "$description": "Active focus ring & cyber neon highlight (rgb: 91, 102, 214)"
      },
      "canvas-subtle": {
        "$value": "rgba(255, 255, 255, 0.1)",
        "$type": "color",
        "$description": "Light subtle border on dark surfaces (rgba 10%)"
      }
    },
    "heatmap": {
      "zero": {
        "$value": "#12162B",
        "$type": "color",
        "$description": "Calendar heatmap: 0 detections / No thermal anomaly"
      },
      "low": {
        "$value": "#4A2612",
        "$type": "color",
        "$description": "Calendar heatmap: 1 - 50 detections (Low fire alert)"
      },
      "mid": {
        "$value": "#8A380A",
        "$type": "color",
        "$description": "Calendar heatmap: 50 - 200 detections (Moderate activity)"
      },
      "high": {
        "$value": "#FF6B1A",
        "$type": "color",
        "$description": "Calendar heatmap: 200 - 500 detections (High outbreak)"
      },
      "peak": {
        "$value": "#FFD23F",
        "$type": "color",
        "$description": "Calendar heatmap: 500+ detections (Extreme emergency peak)"
      }
    },
    "text": {
      "primary": {
        "$value": "#FFFFFF",
        "$type": "color",
        "$description": "High contrast primary text & headings"
      },
      "secondary": {
        "$value": "#F8F8F8",
        "$type": "color",
        "$description": "Slight off-white secondary text from base swatches"
      },
      "muted": {
        "$value": "#9AA6C8",
        "$type": "color",
        "$description": "Muted description, metadata, coordinates"
      },
      "dark-contrast": {
        "$value": "#05050C",
        "$type": "color",
        "$description": "Text on bright Flare buttons (Orange/Amber/Yellow)"
      }
    },
    "canvas": {
      "neutral": {
        "$value": "#444444",
        "$type": "color",
        "$description": "Figma Base Design System canvas gray"
      }
    }
  },
  "gradient": {
    "button": {
      "$value": "linear-gradient(180deg, #FF9F1C 0%, #FF6B1A 50%, #E04006 100%)",
      "$type": "gradient",
      "$description": "Primary CTA button thermal gradient from Base Design System"
    },
    "thermal": {
      "$value": "linear-gradient(180deg, #FF9F1C 0%, #E04006 100%)",
      "$type": "gradient",
      "$description": "Two-stop solar thermal gradient"
    },
    "flame-mark": {
      "$value": "linear-gradient(163deg, #FF9F1C 34%, #FF6B1A 89%, #E04006 100%)",
      "$type": "gradient",
      "$description": "FireCal Logomark flame gradient vector"
    },
    "foliage-mark": {
      "$value": "linear-gradient(180deg, #5FD678 12%, #2CBC84 77%)",
      "$type": "gradient",
      "$description": "FireCal Logomark forest leaf gradient vector"
    },
    "surface-dark": {
      "$value": "linear-gradient(180deg, #12152E 0%, #0A0C18 100%)",
      "$type": "gradient",
      "$description": "Elevated cyber panel background gradient"
    }
  },
  "typography": {
    "fontFamily": {
      "display": {
        "$value": "'Space Grotesk', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "interface": {
        "$value": "'Figtree', 'Plus Jakarta Sans', system-ui, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'JetBrains Mono', monospace",
        "$type": "fontFamily"
      }
    },
    "styles": {
      "display-logo": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "277px", "$type": "dimension" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "fontStyle": "Medium",
        "description": "Logotype brand scale from Figma Base Design System"
      },
      "heading-xl": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "75px", "$type": "dimension" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "lineHeight": { "$value": "96px", "$type": "dimension" },
        "fontStyle": "Medium",
        "description": "Heading style from Base Design System #12:10390"
      },
      "display-2xl": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "36px", "$type": "dimension" },
        "fontWeight": { "$value": 700, "$type": "fontWeight" },
        "lineHeight": { "$value": "44px", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.02em", "$type": "dimension" },
        "fontStyle": "Bold",
        "description": "Hero Title and Page Landmark headers"
      },
      "subheading": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "35px", "$type": "dimension" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "lineHeight": { "$value": "45px", "$type": "dimension" },
        "fontStyle": "Medium",
        "description": "Subheading from Base Design System #12:10388"
      },
      "heading-l": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "24px", "$type": "dimension" },
        "fontWeight": { "$value": 600, "$type": "fontWeight" },
        "lineHeight": { "$value": "32px", "$type": "dimension" },
        "letterSpacing": { "$value": "-0.01em", "$type": "dimension" },
        "fontStyle": "SemiBold",
        "description": "Panel headers and modal titles"
      },
      "button-medium": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "25px", "$type": "dimension" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "lineHeight": { "$value": "32px", "$type": "dimension" },
        "fontStyle": "Medium",
        "description": "Button Medium from Base Design System #12:10394"
      },
      "body-base": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "22px", "$type": "dimension" },
        "fontWeight": { "$value": 400, "$type": "fontWeight" },
        "lineHeight": { "$value": "28px", "$type": "dimension" },
        "fontStyle": "Regular",
        "description": "Body Text from Base Design System #12:10392"
      },
      "heading-m": {
        "fontFamily": "{typography.fontFamily.display}",
        "fontSize": { "$value": "18px", "$type": "dimension" },
        "fontWeight": { "$value": 600, "$type": "fontWeight" },
        "lineHeight": { "$value": "24px", "$type": "dimension" },
        "fontStyle": "SemiBold",
        "description": "Section headers & interactive accordions"
      },
      "body-large": {
        "fontFamily": "{typography.fontFamily.interface}",
        "fontSize": { "$value": "15px", "$type": "dimension" },
        "fontWeight": { "$value": 500, "$type": "fontWeight" },
        "lineHeight": { "$value": "24px", "$type": "dimension" },
        "fontStyle": "Medium",
        "description": "Interface explanatory body copy"
      },
      "ui-semibold": {
        "fontFamily": "{typography.fontFamily.interface}",
        "fontSize": { "$value": "13px", "$type": "dimension" },
        "fontWeight": { "$value": 600, "$type": "fontWeight" },
        "lineHeight": { "$value": "18px", "$type": "dimension" },
        "fontStyle": "SemiBold",
        "description": "Standard UI button text and navigation chips"
      },
      "caption": {
        "fontFamily": "{typography.fontFamily.interface}",
        "fontSize": { "$value": "12px", "$type": "dimension" },
        "fontWeight": { "$value": 400, "$type": "fontWeight" },
        "lineHeight": { "$value": "16px", "$type": "dimension" },
        "fontStyle": "Regular",
        "description": "Metadata, satellite pass info, timestamps"
      },
      "badge": {
        "fontFamily": "{typography.fontFamily.interface}",
        "fontSize": { "$value": "11px", "$type": "dimension" },
        "fontWeight": { "$value": 700, "$type": "fontWeight" },
        "lineHeight": { "$value": "14px", "$type": "dimension" },
        "letterSpacing": { "$value": "0.05em", "$type": "dimension" },
        "fontStyle": "Bold",
        "description": "Micro badges, sensor pill indicators (VIIRS/MODIS)"
      }
    }
  },
  "effect": {
    "shadow": {
      "soft": {
        "$value": "0px 4px 48px 0px rgba(0, 0, 0, 0.02)",
        "$type": "boxShadow"
      },
      "card": {
        "$value": "0px 8px 32px 0px rgba(0, 0, 0, 0.35)",
        "$type": "boxShadow"
      },
      "glow-flare": {
        "$value": "0px 0px 24px 0px rgba(255, 107, 26, 0.4)",
        "$type": "boxShadow"
      },
      "glow-cyber": {
        "$value": "0px 0px 20px 0px rgba(91, 102, 214, 0.35)",
        "$type": "boxShadow"
      }
    },
    "radius": {
      "sm": { "$value": "6px", "$type": "dimension" },
      "md": { "$value": "10px", "$type": "dimension" },
      "lg": { "$value": "14px", "$type": "dimension" },
      "xl": { "$value": "24px", "$type": "dimension" },
      "full": { "$value": "9999px", "$type": "dimension" }
    }
  },
  "asset": {
    "logo": {
      "full": {
        "$value": "design-system/FIRECAL LOGO.svg",
        "$type": "file",
        "$description": "FireCal full logo with logomark and Space Grotesk brand text (1209x354)"
      },
      "mark": {
        "$value": "design-system/FIRECAL LOGOMARK.svg",
        "$type": "file",
        "$description": "FireCal logomark icon with flame, leaf, and orbit line (267x330)"
      }
    }
  }
}
