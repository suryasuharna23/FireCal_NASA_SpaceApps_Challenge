    "@turf/distance": "^7.4.0",
    "d3": "^7.9.2",
    "echarts": "^5.6.0",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "terra-draw": "^1.39.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
