# .env - backend & pipeline (copy to .env, never commit the real file)
FIRMS_MAP_KEY=your_map_key_here
FIRMS_API_BASE=https://firms.modaps.eosdis.nasa.gov/api
DATA_URI=./data/processed
COVERAGE_BBOX=-180,-90,180,90
GRID_RES_DEG=0.25
MODIS_MIN_CONFIDENCE=30
VIIRS_CONFIDENCE=nominal,high
STATIC_MASK_DEG=0.02
CALIBRATION_PERIOD=2013-01:2021-12
TEST_YEARS=2016,2019
TRANSITION_MONTH=
MIN_CELL_DETECTIONS=50
CALIBRATION_SHRINKAGE=100
REFERENCE_YEARS=2003:2022
MAX_AOI_KM2=1000000
CORS_ORIGINS=http://localhost:5173
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
LOG_LEVEL=info
